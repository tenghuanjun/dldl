{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DLDL-Proxy",
  "version": "1.0.0",
  "identifier": "com.dldl.localproxy",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/ensure-bundled-node.mjs && node scripts/codesign-macos-bundle-deps.mjs",
    "frontendDist": "../webview-stub"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../account.html": "app/account.html",
      "../bundle.js": "app/bundle.js",
      "../cc.js": "app/cc.js",
      "../d3j4a5s8d3.js": "app/d3j4a5s8d3.js",
      "../dldl-login-inject.js": "app/dldl-login-inject.js",
      "../enter.js": "app/enter.js",
      "../index.html": "app/index.html",
      "../md5.js": "app/md5.js",
      "../proxy.js": "app/proxy.js",
      "../proxy-pool.js": "app/proxy-pool.js",
      "../config.js": "app/config.js",
      "../dldl-uinfo.js": "app/dldl-uinfo.js",
      "../skin.js": "app/skin.js",
      "../vue.global.js": "app/vue.global.js",
      "../package.json": "app/package.json",
      "../node_modules": "app/node_modules",
      "../lib": "app/lib",
      "_embed/nodejs": "app/nodejs"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
